### ====================================================================
### 3. F10: THIẾT LẬP DANH SÁCH NHÓM KIẾN THỨC (PUT /api/curriculums/{id}/knowledge-groups)
### Kỳ vọng: 200 OK, lưu 3 nhóm DC, CS, CN
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("testCurriculumId")) {
        request.variables.set("testCurriculumId", client.global.get("testCurriculumId"));
    }
%}
PUT http://localhost:8080/api/curriculums/{{testCurriculumId}}/knowledge-groups
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
  { "groupCode": "DC", "groupName": "Khối kiến thức đại cương", "order": 1 },
  { "groupCode": "CS", "groupName": "Khối kiến thức cơ sở ngành", "order": 2 },
  { "groupCode": "CN", "groupName": "Khối kiến thức chuyên ngành", "order": 3 }
]

> {%
    client.test("Replace knowledge groups returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.knowledgeGroups.length === 3, "Expected 3 knowledge groups");
    });
%}

### ====================================================================
### 4. F10: THÊM TỪNG NHÓM KIẾN THỨC MỚI (POST /api/curriculums/{id}/knowledge-groups)
### Kỳ vọng: 201 Created
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("testCurriculumId")) {
        request.variables.set("testCurriculumId", client.global.get("testCurriculumId"));
    }
%}
POST http://localhost:8080/api/curriculums/{{testCurriculumId}}/knowledge-groups
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "groupCode": "TT",
  "groupName": "Khối kiến thức thực tập và tốt nghiệp",
  "order": 4
}

> {%
    client.test("Add knowledge group returns 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.knowledgeGroups.length === 4, "Expected 4 knowledge groups");
    });
%}

