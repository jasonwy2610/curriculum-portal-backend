### ====================================================================
### 6. F16 & F17: CẤU HÌNH ĐỊNH HƯỚNG & THỜI ĐIỂM CHỌN (PUT /api/curriculums/{id}/specializations)
### Kỳ vọng: 200 OK (specializationSelectionTiming = "LATER", semester = 5)
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("testCurriculumId")) {
        request.variables.set("testCurriculumId", client.global.get("testCurriculumId"));
    }
%}
PUT http://localhost:8080/api/curriculums/{{testCurriculumId}}/specializations
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "specializationSelectionTiming": "LATER",
  "specializationSelectionSemester": 5,
  "specializations": [
    { "code": "CNPM", "name": "Công nghệ Phần mềm" },
    { "code": "AI", "name": "Trí tuệ Nhân tạo & Dữ liệu lớn" },
    { "code": "ATBM", "name": "An toàn và Bảo mật thông tin" }
  ]
}

> {%
    client.test("Configure specializations returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body.data.specializationSelectionTiming === "LATER", "Timing must be LATER");
        client.assert(response.body.data.specializationSelectionSemester === 5, "Semester must be 5");
        client.assert(response.body.data.specializations.length === 3, "Expected 3 specializations");
    });
%}

