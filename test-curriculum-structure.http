@authToken = dummy
@testCurriculumId = dummy

### ====================================================================
### TEST SUITE: PHASE A3 - QUẢN LÝ CẤU TRÚC CTĐT (F10, F11, F12, F13, F14, F16, F17)
### Base URL: http://localhost:8080/api/curriculums
### Chuẩn: Native IntelliJ IDEA HTTP Client (> {% ... %} & < {% ... %})
### ====================================================================

### 1. Đăng nhập Admin lấy JWT Token
# @name loginAdmin
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@huflit.edu.vn",
  "password": "123456"
}

> {%
    client.test("Login Admin returns 200 and token", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.token != null, "Token must not be null");
    });
    if (response.body && response.body.data && response.body.data.token) {
        client.global.set("authToken", response.body.data.token);
    }
%}

### ====================================================================
### 2. LẤY HOẶC KHỞI TẠO CTĐT THỬ NGHIỆM QUA ENDPOINTS CHUẨN (IDEMPOTENT)
### ====================================================================

### 2a. Khởi tạo CTĐT nếu chưa tồn tại (POST /api/curriculums)
# @name createTestCurriculum
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/curriculums
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "curriculumCode": "CTDT-CNTT-K2026-STRUCT",
  "curriculumName": "Chương trình đào tạo Thử nghiệm Cấu trúc 2026",
  "majorId": "66e01a01f1a2b3c4d5e6f902",
  "cohort": "K2026",
  "appliedYear": 2026,
  "description": "CTĐT phục vụ kiểm thử cấu trúc (F10–F17)",
  "status": "ACTIVE",
  "specializationSelectionTiming": "LATER",
  "specializationSelectionSemester": 4
}

> {%
    client.test("Create test curriculum returns 201 or 400 (already exists)", function() {
        client.assert(response.status === 201 || response.status === 400, "Expected 201 Created or 400 Already Exists");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("testCurriculumId", response.body.data.id);
    }
%}

### 2b. Lấy thông tin CTĐT chuẩn theo mã nghiệp vụ (GET /api/curriculums/code/{code})
# @name getTestCurriculumByCode
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/curriculums/code/CTDT-CNTT-K2026-STRUCT
Authorization: Bearer {{authToken}}

> {%
    client.test("Fetch test curriculum by code returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.id != null, "Curriculum ID must not be null");
        client.assert(response.body.data.curriculumCode === "CTDT-CNTT-K2026-STRUCT", "Expected code CTDT-CNTT-K2026-STRUCT");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("testCurriculumId", response.body.data.id);
    }
%}

### 2c. Dọn dẹp học phần tồn đọng từ các lần chạy trước để đảm bảo idempotency
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("testCurriculumId")) {
        request.variables.set("testCurriculumId", client.global.get("testCurriculumId"));
    }
%}
DELETE http://localhost:8080/api/curriculums/{{testCurriculumId}}/courses/1250052
Authorization: Bearer {{authToken}}

> {%
    client.test("Cleanup course 1250052 returns 200 or 400", function() {
        client.assert(response.status === 200 || response.status === 400, "Expected 200 or 400");
    });
%}

