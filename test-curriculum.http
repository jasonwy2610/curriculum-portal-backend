### 5. NEGATIVE TEST 1: TẠO TRÙNG MÃ CTĐT (DUPLICATE curriculumCode)
### Kỳ vọng: 400 Bad Request, "Mã chương trình đào tạo 'CTDT-CNTT-K2026-CH' đã tồn tại trong hệ thống"
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/curriculums
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "curriculumCode": "CTDT-CNTT-K2026-CH",
  "curriculumName": "CTĐT Trùng Lặp",
  "majorId": "66e01a01f1a2b3c4d5e6f902",
  "cohort": "K2026",
  "appliedYear": 2026
}

> {%
    client.test("Duplicate curriculumCode returns 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request but got " + response.status);
    });
%}

