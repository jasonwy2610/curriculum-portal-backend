### ====================================================================
### 7. F06: CẬP NHẬT THÔNG TIN CTĐT (PUT /api/curriculums/{id})
### Lưu ý: curriculumCode là bất biến (không thay đổi)
### Kỳ vọng: 200 OK kèm thông tin đã cập nhật
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCurriculumId")) {
        request.variables.set("createdCurriculumId", client.global.get("createdCurriculumId"));
    }
%}
PUT http://localhost:8080/api/curriculums/{{createdCurriculumId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "curriculumName": "Chương trình đào tạo Công nghệ Thông tin Chuẩn - Khóa 2026 (Đã cập nhật)",
  "cohort": "K2026",
  "appliedYear": 2026,
  "totalCredits": 140,
  "description": "Bổ sung môn đồ án tốt nghiệp và thực tập doanh nghiệp",
  "status": "ACTIVE",
  "specializationSelectionTiming": "LATER",
  "specializationSelectionSemester": 4
}

> {%
    client.test("Update curriculum returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.totalCredits === 140, "totalCredits was not updated");
        client.assert(response.body && response.body.data && response.body.data.curriculumCode === "CTDT-CNTT-K2026-CH", "curriculumCode must not change");
    });
%}

### ====================================================================
### 8. F07: DEEP CLONE CTĐT SANG KHÓA MỚI (POST /api/curriculums/{id}/clone)
### Thực hiện Deep Clone toàn bộ cây kiến thức, học kỳ, môn học sang CTĐT mới
### Kỳ vọng: 201 Created, clonedFromCurriculumId = ID bản gốc
### ====================================================================
# @name cloneCurriculum
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCurriculumId")) {
        request.variables.set("createdCurriculumId", client.global.get("createdCurriculumId"));
    }
%}
POST http://localhost:8080/api/curriculums/{{createdCurriculumId}}/clone
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newCurriculumCode": "CTDT-CNTT-K2027",
  "newCurriculumName": "Chương trình đào tạo Công nghệ Thông tin - Khóa 2027 (Kế thừa từ K2026)",
  "newCohort": "K2027",
  "newAppliedYear": 2027,
  "description": "Bản sao độc lập cho khóa tuyển sinh 2027",
  "status": "ACTIVE"
}

> {%
    client.test("Clone curriculum returns 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.id != null, "Cloned ID must not be null");
        client.assert(response.body && response.body.data && response.body.data.clonedFromCurriculumId === client.global.get("createdCurriculumId"), "clonedFromCurriculumId must point to original");
        client.assert(response.body && response.body.data && response.body.data.curriculumCode === "CTDT-CNTT-K2027", "Expected curriculumCode CTDT-CNTT-K2027");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("clonedCurriculumId", response.body.data.id);
    }
%}

### ====================================================================
### 9. XÁC NHẬN TÍNH ĐỘC LẬP CỦA BẢN CLONE (BR03)
### Kỳ vọng: Xem chi tiết bản clone, clonedFromCurriculumId trỏ đến createdCurriculumId,
### đầy đủ cấu trúc nested specializations, knowledgeGroups, semesters
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCurriculumId")) {
        request.variables.set("createdCurriculumId", client.global.get("createdCurriculumId"));
    }
    if (client.global.get("clonedCurriculumId")) {
        request.variables.set("clonedCurriculumId", client.global.get("clonedCurriculumId"));
    }
%}
GET http://localhost:8080/api/curriculums/{{clonedCurriculumId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Verify clone structure independence", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.clonedFromCurriculumId === client.global.get("createdCurriculumId"), "clonedFrom must match source ID");
        client.assert(response.body && response.body.data && response.body.data.knowledgeGroups.length > 0, "knowledgeGroups must be copied");
        client.assert(response.body && response.body.data && response.body.data.semesters.length > 0, "semesters must be copied");
    });
%}

### ====================================================================
### 10. F09: SOFT DELETE / LƯU TRỮ CTĐT (DELETE /api/curriculums/{id})
### Kỳ vọng: status chuyển thành "ARCHIVED", tài liệu KHÔNG bị xóa khỏi MongoDB (BR02)
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCurriculumId")) {
        request.variables.set("createdCurriculumId", client.global.get("createdCurriculumId"));
    }
%}
DELETE http://localhost:8080/api/curriculums/{{createdCurriculumId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Soft delete curriculum returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.status === "ARCHIVED", "Expected status ARCHIVED");
    });
%}

### ====================================================================
### 11. XÁC NHẬN TRẠNG THÁI SAU KHI XÓA MỀM (STATUS = "ARCHIVED")
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCurriculumId")) {
        request.variables.set("createdCurriculumId", client.global.get("createdCurriculumId"));
    }
%}
GET http://localhost:8080/api/curriculums/{{createdCurriculumId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Verify status after soft delete is ARCHIVED", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.status === "ARCHIVED", "Status must be ARCHIVED");
    });
%}
