@authToken = dummy
@createdCurriculumId = dummy
@clonedCurriculumId = dummy
@seededCurriculumId = dummy

### ====================================================================
### TEST SUITE: PHASE A2 - QUẢN LÝ CHƯƠNG TRÌNH ĐÀO TẠO (CURRICULUM CORE, DEEP CLONE & VERSIONING)
### Chức năng: F04, F05, F08, F06, F07, F09
### Base URL: http://localhost:8080/api/curriculums
### Chuẩn: Native IntelliJ IDEA HTTP Client (> {% ... %} & < {% ... %})
### ====================================================================

### 1. Đăng nhập Admin lấy JWT Token
# @name loginAdmin
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@huflit.edu.vn",
  "password": "123456"
}

> {%
    client.test("Login Admin returns 200 and token", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.token != null, "Token must not be null");
    });
    if (response.body && response.body.data && response.body.data.token) {
        client.global.set("authToken", response.body.data.token);
    }
%}

### ====================================================================
### 2. F04: TRUY VẤN DANH SÁCH CTĐT & LỌC THEO KHÓA (GET /api/curriculums)
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/curriculums?cohort=K2025
Authorization: Bearer {{authToken}}

> {%
    client.test("Get curriculums by cohort returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.length > 0, "Curriculums list should not be empty");
    });
%}

### ====================================================================
### 3. F08: XEM CHI TIẾT CTĐT THEO MÃ (GET /api/curriculums/code/{curriculumCode})
### ====================================================================
# @name getSeededCurriculum
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/curriculums/code/CTDT-CNTT-K2025
Authorization: Bearer {{authToken}}

> {%
    client.test("Get seeded curriculum returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.curriculumCode === "CTDT-CNTT-K2025", "Code mismatch");
        client.assert(response.body && response.body.data && response.body.data.id != null, "Seeded curriculum ID must not be null");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("seededCurriculumId", response.body.data.id);
    }
%}

### ====================================================================
### 4. F05: TẠO MỚI CHƯƠNG TRÌNH ĐÀO TẠO (HAPPY PATH - POST /api/curriculums)
### Kỳ vọng: 201 Created
### ====================================================================
# @name createCurriculum
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/curriculums
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "curriculumCode": "CTDT-CNTT-K2026-CH",
  "curriculumName": "Chương trình đào tạo Công nghệ Thông tin Chuẩn - Khóa 2026",
  "majorId": "66e01a01f1a2b3c4d5e6f902",
  "cohort": "K2026",
  "appliedYear": 2026,
  "totalCredits": 135,
  "description": "CTĐT chất lượng cao định hướng phát triển AI và Cloud",
  "status": "ACTIVE",
  "specializationSelectionTiming": "LATER",
  "specializationSelectionSemester": 3,
  "specializations": [
    { "code": "CNPM", "name": "Công nghệ Phần mềm" },
    { "code": "AI", "name": "Trí tuệ Nhân tạo & Dữ liệu lớn" }
  ],
  "knowledgeGroups": [
    { "groupCode": "DC", "groupName": "Kiến thức đại cương", "order": 1 },
    { "groupCode": "CS", "groupName": "Kiến thức cơ sở ngành", "order": 2 },
    { "groupCode": "CN", "groupName": "Kiến thức chuyên ngành", "order": 3 }
  ],
  "semesters": [
    {
      "semesterNumber": 1,
      "courses": [
        {
          "courseCode": "1250052",
          "courseName": "Nhập môn công nghệ thông tin",
          "credits": 2,
          "type": "MANDATORY",
          "knowledgeGroupCode": "CS",
          "specializationCodes": [],
          "prerequisiteCourseCodes": []
        },
        {
          "courseCode": "1250064",
          "courseName": "Nhập môn lập trình",
          "credits": 4,
          "type": "MANDATORY",
          "knowledgeGroupCode": "CS",
          "specializationCodes": [],
          "prerequisiteCourseCodes": []
        }
      ]
    },
    {
      "semesterNumber": 2,
      "courses": [
        {
          "courseCode": "1221014",
          "courseName": "Cấu trúc dữ liệu và giải thuật",
          "credits": 4,
          "type": "MANDATORY",
          "knowledgeGroupCode": "CN",
          "specializationCodes": ["CNPM", "AI"],
          "prerequisiteCourseCodes": ["1250064"]
        }
      ]
    }
  ]
}

> {%
    client.test("Create Curriculum returns 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.id != null, "Curriculum ID must not be null");
        client.assert(response.body && response.body.data && response.body.data.curriculumCode === "CTDT-CNTT-K2026-CH", "Code mismatch");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("createdCurriculumId", response.body.data.id);
    }
%}

