@authToken = dummy
@targetCourseId = dummy
@targetCurriculumId = dummy

### ====================================================================
### TEST SUITE: PHASE A4 - TÌM KIẾM NÂNG CAO (F39) & AUDIT TRAIL (F41, F42)
### Base URL: http://localhost:8080/api
### Chuẩn: Native IntelliJ IDEA HTTP Client (> {% ... %} & < {% ... %})
### ====================================================================

### 1. Đăng nhập Admin lấy JWT Token
# @name loginAdmin
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@huflit.edu.vn",
  "password": "123456"
}

> {%
    client.test("Login Admin returns 200 and token", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.token != null, "Token must not be null");
    });
    if (response.body && response.body.data && response.body.data.token) {
        client.global.set("authToken", response.body.data.token);
    }
%}

### ====================================================================
### PHẦN 1: F39 — TÌM KIẾM & BỘ LỌC NÂNG CAO CHƯƠNG TRÌNH ĐÀO TẠO
### ====================================================================

### 2. F39: Tìm kiếm CTĐT theo từ khóa (keyword = "Công nghệ Thông tin")
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/curriculums?keyword=Công nghệ Thông tin
Authorization: Bearer {{authToken}}

> {%
    client.test("Search curriculums by keyword returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.length > 0, "Expected at least 1 matching curriculum");
    });
%}

### 3. F39: Lọc CTĐT theo khóa tuyển sinh và trạng thái (cohort = K2025 & status = ACTIVE)
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/curriculums?cohort=K2025&status=ACTIVE
Authorization: Bearer {{authToken}}

> {%
    client.test("Filter curriculums by cohort and status returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        if (response.body.data.length > 0) {
            client.assert(response.body.data[0].cohort === "K2025", "Cohort must be K2025");
            client.assert(response.body.data[0].status === "ACTIVE", "Status must be ACTIVE");
        }
    });
%}

