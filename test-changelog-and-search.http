### ====================================================================
### PHẦN 2: F42 — AUDIT TRAIL / CHANGE LOGS CHO HỌC PHẦN (COURSE)
### ====================================================================

### 6. Khởi tạo hoặc chuẩn bị học phần 1250099 để kiểm thử F42
# @name createOrEnsureCourse
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/courses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseCode": "1250099",
  "courseName": "Lập trình Web Nâng Cao F42",
  "credits": 3,
  "theoryHours": 30,
  "practiceHours": 30,
  "department": "Khoa Công nghệ Thông tin",
  "description": "Học phần phục vụ kiểm thử Audit Trail F42",
  "status": "ACTIVE"
}

> {%
    client.test("Create course returns 201 or 400 (already exists)", function() {
        client.assert(response.status === 201 || response.status === 400, "Expected 201 or 400");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("targetCourseId", response.body.data.id);
    }
%}

### 7. Lấy chi tiết học phần 1250099 để lấy chính xác targetCourseId
# @name getCourseByCode
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/courses/code/1250099
Authorization: Bearer {{authToken}}

> {%
    client.test("Get course 1250099 returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.id != null, "Course ID must not be null");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("targetCourseId", response.body.data.id);
    }
%}

### 8. F42: Cập nhật học phần 1250099 (đổi credits từ 3 sang 4, đổi tên học phần)
# @name updateCourseTest
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("targetCourseId")) {
        request.variables.set("targetCourseId", client.global.get("targetCourseId"));
    }
%}
PUT http://localhost:8080/api/courses/{{targetCourseId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseName": "Lập trình Web Nâng Cao và Điện toán Đám mây F42",
  "credits": 4,
  "theoryHours": 45,
  "practiceHours": 30,
  "department": "Khoa Công nghệ Thông tin",
  "description": "Mô tả đã được cập nhật kiểm thử vết kiểm toán F42",
  "status": "ACTIVE"
}

> {%
    client.test("Update course returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body.data.credits === 4, "Credits must be 4");
    });
%}

### 9. F42: Tra cứu vết kiểm toán học phần qua API lọc chung (GET /api/change-logs?entityType=Course)
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("targetCourseId")) {
        request.variables.set("targetCourseId", client.global.get("targetCourseId"));
    }
%}
GET http://localhost:8080/api/change-logs?entityType=Course&entityId={{targetCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Query course change logs returns 200 OK with recorded changes", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.length > 0, "Must have recorded change logs");
        var latest = response.body.data[0];
        client.assert(latest.entityType === "Course", "Entity type must be Course");
        client.assert(latest.action === "UPDATE" || latest.action === "CREATE", "Action must be UPDATE or CREATE");
        client.assert(latest.changedBy != null, "changedBy ObjectId must be recorded");
        client.assert(latest.changes != null && latest.changes.length > 0, "Changes array must not be empty");
    });
%}

### 10. F42: Tra cứu vết kiểm toán học phần qua sub-resource (GET /api/courses/{id}/change-logs)
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("targetCourseId")) {
        request.variables.set("targetCourseId", client.global.get("targetCourseId"));
    }
%}
GET http://localhost:8080/api/courses/{{targetCourseId}}/change-logs
Authorization: Bearer {{authToken}}

> {%
    client.test("Course sub-resource change-logs returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body.data.length > 0, "Expected at least 1 change log entry");
    });
%}

### 11. F42: Xóa mềm học phần (DELETE /api/courses/{id}) và kiểm tra audit log ghi nhận action UPDATE
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("targetCourseId")) {
        request.variables.set("targetCourseId", client.global.get("targetCourseId"));
    }
%}
DELETE http://localhost:8080/api/courses/{{targetCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Soft delete course returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body.data.status === "INACTIVE", "Status must become INACTIVE");
    });
%}

### 12. F42: Kiểm tra audit log của thao tác xóa mềm (chuyển status -> INACTIVE)
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("targetCourseId")) {
        request.variables.set("targetCourseId", client.global.get("targetCourseId"));
    }
%}
GET http://localhost:8080/api/change-logs/course/{{targetCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Verify soft delete change log recorded in MongoDB", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        var latest = response.body.data[0];
        client.assert(latest.action === "UPDATE", "Soft delete action must be recorded as UPDATE");
        var hasStatusChange = latest.changes.some(function(c) {
            return c.field === "status" && c.newValue === "INACTIVE";
        });
        client.assert(hasStatusChange, "Changes must record status changing to INACTIVE");
    });
%}

