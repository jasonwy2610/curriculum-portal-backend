@authToken = dummy
@createdCourseId = dummy

### ====================================================================
### TEST SUITE: F18, F19, F20 - QUẢN LÝ DANH MỤC HỌC PHẦN (COURSE CATALOG)
### Base URL: http://localhost:8080/api/courses
### Chuẩn: Native IntelliJ IDEA HTTP Client (> {% ... %} & < {% ... %})
### ====================================================================

### 1. Đăng nhập Admin lấy JWT Token
# @name loginAdmin
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@huflit.edu.vn",
  "password": "123456"
}

> {%
    client.test("Login Admin returns 200 and token", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.token != null, "Token must not be null");
    });
    if (response.body && response.body.data && response.body.data.token) {
        client.global.set("authToken", response.body.data.token);
    }
%}

### ====================================================================
### 2. F18: TẠO HỌC PHẦN MỚI (HAPPY PATH - POST /api/courses)
### Kỳ vọng: 201 Created
### ====================================================================
# @name createCourse
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/courses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseCode": "1250099",
  "courseName": "Trí tuệ nhân tạo",
  "credits": 3,
  "theoryHours": 30,
  "practiceHours": 30,
  "description": "Học phần nền tảng về AI và Machine Learning",
  "department": "Khoa CNTT",
  "status": "ACTIVE"
}

> {%
    client.test("Create Course returns 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.id != null, "Course ID must not be null");
        client.assert(response.body && response.body.data && response.body.data.courseCode === "1250099", "Expected courseCode 1250099");
    });
    if (response.body && response.body.data && response.body.data.id) {
        client.global.set("createdCourseId", response.body.data.id);
    }
%}

### ====================================================================
### 3. NEGATIVE TEST 1: TẠO TRÙNG MÃ HỌC PHẦN (DUPLICATE courseCode)
### Kỳ vọng: 400 Bad Request, thông báo "Mã học phần '1250099' đã tồn tại trong hệ thống"
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/courses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseCode": "1250099",
  "courseName": "Trùng mã học phần",
  "credits": 2,
  "theoryHours": 15,
  "practiceHours": 15,
  "department": "Khoa CNTT"
}

> {%
    client.test("Duplicate courseCode returns 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request but got " + response.status);
    });
%}

### ====================================================================
### 4. NEGATIVE TEST 2: VALIDATION LỖI — Mã và tên trống
### Kỳ vọng: 400 Bad Request kèm thông báo validation
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/courses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseCode": "",
  "courseName": "",
  "credits": 2,
  "theoryHours": 15,
  "practiceHours": 15
}

> {%
    client.test("Empty code/name returns 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request but got " + response.status);
    });
%}

### ====================================================================
### 5. NEGATIVE TEST 3: VALIDATION LỖI — credits <= 0
### Kỳ vọng: 400 Bad Request, "Số tín chỉ phải lớn hơn hoặc bằng 1"
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
POST http://localhost:8080/api/courses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseCode": "9999999",
  "courseName": "Học phần tín chỉ sai",
  "credits": 0,
  "theoryHours": 15,
  "practiceHours": 15
}

> {%
    client.test("Invalid credits returns 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request but got " + response.status);
    });
%}

### ====================================================================
### 6. F19: LẤY TẤT CẢ HỌC PHẦN (GET /api/courses)
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/courses
Authorization: Bearer {{authToken}}

> {%
    client.test("Get all courses returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.length > 0, "Courses list should not be empty");
    });
%}

### ====================================================================
