        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.courseCode === "1250052", "Seeded courseCode mismatch");
    });
%}

### ====================================================================
### 13. F18: CẬP NHẬT THÔNG TIN HỌC PHẦN (PUT /api/courses/{id})
### Lưu ý: courseCode KHÔNG thay đổi, chỉ cập nhật các trường cho phép
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCourseId")) {
        request.variables.set("createdCourseId", client.global.get("createdCourseId"));
    }
%}
PUT http://localhost:8080/api/courses/{{createdCourseId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "courseName": "Trí tuệ nhân tạo & Học sâu",
  "credits": 4,
  "theoryHours": 45,
  "practiceHours": 30,
  "description": "Nâng cấp nội dung bao gồm Deep Learning và Neural Networks",
  "department": "Khoa CNTT",
  "status": "ACTIVE"
}

> {%
    client.test("Update course returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.courseName === "Trí tuệ nhân tạo & Học sâu", "Course name not updated");
        client.assert(response.body && response.body.data && response.body.data.credits === 4, "Credits not updated");
    });
%}

### ====================================================================
### 14. XÁC NHẬN SAU CẬP NHẬT: courseCode vẫn giữ nguyên "1250099"
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCourseId")) {
        request.variables.set("createdCourseId", client.global.get("createdCourseId"));
    }
%}
GET http://localhost:8080/api/courses/{{createdCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Verify courseCode remains unchanged", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.courseCode === "1250099", "courseCode was altered!");
    });
%}

### ====================================================================
### 15. F18: XÓA MỀM HỌC PHẦN (SOFT DELETE - DELETE /api/courses/{id})
### Kỳ vọng: status chuyển thành "INACTIVE", document không bị xóa khỏi MongoDB
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCourseId")) {
        request.variables.set("createdCourseId", client.global.get("createdCourseId"));
    }
%}
DELETE http://localhost:8080/api/courses/{{createdCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Soft delete course returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.status === "INACTIVE", "Expected status INACTIVE");
    });
%}

### ====================================================================
### 16. XÁC NHẬN TRẠNG THÁI SAU KHI XÓA MỀM (status = "INACTIVE")
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCourseId")) {
        request.variables.set("createdCourseId", client.global.get("createdCourseId"));
    }
%}
GET http://localhost:8080/api/courses/{{createdCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Verify status after soft delete is INACTIVE", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.status === "INACTIVE", "Status must be INACTIVE");
    });
%}
