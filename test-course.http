### ====================================================================
### 10. F20: XEM CHI TIẾT HỌC PHẦN THEO ID
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
    if (client.global.get("createdCourseId")) {
        request.variables.set("createdCourseId", client.global.get("createdCourseId"));
    }
%}
GET http://localhost:8080/api/courses/{{createdCourseId}}
Authorization: Bearer {{authToken}}

> {%
    client.test("Get course by ID returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.id === client.global.get("createdCourseId"), "Course ID mismatch");
    });
%}

### ====================================================================
### 11. F20: XEM CHI TIẾT HỌC PHẦN THEO MÃ HỌC PHẦN (BUSINESS KEY)
### ====================================================================
< {%
    if (client.global.get("authToken")) {
        request.variables.set("authToken", client.global.get("authToken"));
    }
%}
GET http://localhost:8080/api/courses/code/1250099
Authorization: Bearer {{authToken}}

> {%
    client.test("Get course by courseCode returns 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK but got " + response.status);
        client.assert(response.body && response.body.data && response.body.data.courseCode === "1250099", "courseCode mismatch");
    });
%}

